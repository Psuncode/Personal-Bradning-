# Neon Postgres — provided by Vercel-Neon integration
# Pooled connection (for app queries)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DBNAME?sslmode=require

# Unpooled connection (for drizzle-kit migrations ONLY)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DBNAME?sslmode=require

# Main domain for proxy subdomain detection
NEXT_PUBLIC_DOMAIN=philipsun.com

# Admin auth (iron-session)
# Choose a password for /admin access
ADMIN_PASSWORD=your-admin-password-here

# Session secret — generate with: openssl rand -hex 32
# Must be at least 32 characters
SESSION_SECRET=your-32-character-hex-secret-here

# Stripe — payment processing for photography bookings
# Use test mode keys for development (sk_test_... / whsec_test_...)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Photography subdomain URL (used for Stripe success/cancel URLs)
NEXT_PUBLIC_PHOTOGRAPHY_URL=https://photography.philipsun.com

# Resend — transactional email for booking confirmations
# Get API key from Resend Dashboard -> API Keys
RESEND_API_KEY=re_your-resend-api-key
