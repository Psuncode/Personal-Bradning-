# Canonical env-var inventory for this app. Mirrors src/lib/env.ts —
# the registry there (KNOWN_ENV_VARS) is the source of truth. Copy this
# file to `.env.local` and fill in real values for local dev; in Vercel,
# wire the same names through Project Settings -> Environment Variables.

# === Required at BUILD TIME ===
# Resolved at module-load. Missing/empty -> the bundle fails to import.

# 32+ char random hex; generate with: openssl rand -hex 32
SESSION_SECRET=
# e.g. https://philipsun.com — used for Stripe success/cancel URLs
NEXT_PUBLIC_PHOTOGRAPHY_URL=

# === Required at RUNTIME ===
# Resolved lazily on first use. Missing/empty -> the matching request
# (Stripe webhook, checkout, email send, DB query, /admin login) 500s.

# Stripe — payment processing (test keys for dev: sk_test_... / whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email (get from Resend Dashboard -> API Keys)
RESEND_API_KEY=

# Neon Postgres (provided by Vercel-Neon integration)
# Pooled connection — for app queries
DATABASE_URL=
# Unpooled connection — for drizzle-kit migrations ONLY
DATABASE_URL_UNPOOLED=

# iron-session password gate for /admin
ADMIN_PASSWORD=

# === Optional (with defaults) ===
# Bump SESSION_VERSION to invalidate every sealed cookie at once
SESSION_VERSION=1
# Operator notification recipient; falls back to siteConfig.email if unset
BOOKING_NOTIFICATION_EMAIL=

# === Optional (no default — feature-gated) ===
# Main domain for proxy subdomain detection
NEXT_PUBLIC_DOMAIN=philipsun.com

# === Cal.com / CalDAV (Wave 7b will replace) ===
# iCloud CalDAV credentials used by src/app/api/calendar/route.ts to
# fetch busy times for /meet availability. Leaving these unset disables
# the live calendar overlay; static 9-5 Mountain slots still render.
ICAL_USERNAME=
ICAL_PASSWORD=
ICAL_HOST=
ICAL_CALENDAR_PATH=
